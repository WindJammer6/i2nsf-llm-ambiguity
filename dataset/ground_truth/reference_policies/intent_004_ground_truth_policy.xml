<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface">
  <name>ground_truth_policy_intent_004</name>
  <rules>
    <name>ground_truth_rule_intent_004</name>
    <action>
      <primary-action>
        <action>drop</action>
      </primary-action>
    </action>
    <condition>
      <context>
        <device-type>
          <device>computer</device>
        </device-type>
      </context>
      <firewall>
        <source>son-computers</source>
      </firewall>
      <url-category>
        <url-name>malicious-websites</url-name>
      </url-category>
    </condition>
  </rules>
</i2nsf-cfi-policy>
