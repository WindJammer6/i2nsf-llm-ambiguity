<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface">
  <name>ground_truth_policy_intent_006</name>
  <rules>
    <name>ground_truth_rule_intent_006</name>
    <action>
      <primary-action>
        <action>drop</action>
      </primary-action>
    </action>
    <condition>
      <context>
        <device-type>
          <device>computer</device>
        </device-type>
        <time>
          <frequency>weekly</frequency>
          <period>
            <day>monday</day>
            <day>tuesday</day>
            <day>wednesday</day>
            <day>thursday</day>
            <day>friday</day>
            <end-time>15:00:00Z</end-time>
            <start-time>08:00:00Z</start-time>
          </period>
        </time>
        <users>
          <group>
            <name>students</name>
          </group>
        </users>
      </context>
      <firewall>
        <source>student-pcs</source>
      </firewall>
      <url-category>
        <url-name>youtube-x-instagram</url-name>
      </url-category>
    </condition>
  </rules>
</i2nsf-cfi-policy>
