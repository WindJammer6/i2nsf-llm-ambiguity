<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface">
  <name>ground_truth_policy_intent_024</name>
  <rules>
    <name>ground_truth_rule_intent_024</name>
    <action>
      <primary-action>
        <action>rate-limit</action>
        <limit>100000000</limit>
      </primary-action>
    </action>
    <condition>
      <firewall>
        <source>employees</source>
      </firewall>
      <url-category>
        <url-name>video-streaming-websites</url-name>
      </url-category>
    </condition>
    <event>
      <system-event>configuration-change</system-event>
    </event>
  </rules>
</i2nsf-cfi-policy>
