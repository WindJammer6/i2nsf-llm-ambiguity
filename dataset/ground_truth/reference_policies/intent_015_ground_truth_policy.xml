<?xml version="1.0" encoding="UTF-8"?>
<i2nsf-cfi-policy xmlns="urn:ietf:params:xml:ns:yang:ietf-i2nsf-cons-facing-interface">
  <name>ground_truth_policy_intent_015</name>
  <rules>
    <name>ground_truth_rule_intent_015</name>
    <action>
      <primary-action>
        <action>reject</action>
      </primary-action>
      <secondary-action>
        <log-action>rule-log</log-action>
      </secondary-action>
    </action>
    <condition>
      <firewall>
        <destination>specialized-gateway</destination>
        <source>unauthorized-employees</source>
      </firewall>
    </condition>
    <event>
      <system-event>access-violation</system-event>
    </event>
  </rules>
</i2nsf-cfi-policy>
